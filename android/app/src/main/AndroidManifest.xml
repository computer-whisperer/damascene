<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Issue #68 declared Vulkan required here on the premise that
         wgpu's Android backend is Vulkan-only. Issue #143 measured
         otherwise: the instance is built with Backends::all(), GLES is
         a first-class candidate (and wins even on Vulkan 1.3 hardware),
         and the app renders fine on it — so a Vulkan filter hides the
         app from devices it runs on. The real floor is GLES 3.1:
         damascene requires compute shaders, which is exactly the gate
         a GLES 3.0 context fails at device acquisition (cleanly, per
         #68's error surfacing). 0x00030001 encodes GLES 3.1. -->
    <uses-feature android:glEsVersion="0x00030001" android:required="true" />

    <application
        android:hasCode="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.DamasceneShowcase"
        android:supportsRtl="true">
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.DamasceneShowcase">
            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
